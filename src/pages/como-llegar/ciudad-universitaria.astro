---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Cómo llegar', href: '/como-llegar' },
  { label: 'Ciudad Universitaria' }
];
---

<BaseLayout 
  title="Cómo llegar a Ciudad Universitaria en colectivo - BondiCórdoba"
  description="Guía completa de líneas de colectivos que llegan a Ciudad Universitaria (UNC) desde diferentes puntos de Córdoba Capital."
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    
    <h1>🎓 Cómo llegar a Ciudad Universitaria</h1>
    <p class="subtitle">Universidad Nacional de Córdoba - Campus Ciudad Universitaria</p>
    
    <div class="alert alert-warning">
      <strong>⚠️ Datos de ejemplo:</strong> Esta información es ficticia. Consulte fuentes oficiales para planificar su viaje.
    </div>
    
    <section class="section">
      <h2>Líneas que llegan a Ciudad Universitaria</h2>
      
      <div class="line-option">
        <div class="line-badge">5</div>
        <div>
          <h3>Línea Ejemplo 5</h3>
          <p><strong>Desde:</strong> Centro - Nueva Córdoba</p>
          <p><strong>Frecuencia:</strong> Cada 8-12 minutos en horario lectivo</p>
          <p><strong>Tiempo estimado:</strong> 30-40 minutos desde el centro</p>
          <p><strong>Recorrido:</strong> Centro → Av. Vélez Sarsfield → Av. Valparaíso → Ciudad Universitaria</p>
          <a href="/lineas/5" class="btn">Ver recorrido completo</a>
        </div>
      </div>
    </section>
    <section class="section">
      <h2>💡 Consejos para estudiantes</h2>
      <ul class="tips-list">
        <li><strong>Horario pico:</strong> En horario de entrada y salida de clases (7-9 AM y 18-20 PM) las frecuencias suelen ser mayores.</li>
        <li><strong>Tarjeta Red Bus estudiante:</strong> Consulta los descuentos especiales para estudiantes universitarios.</li>
        <li><strong>Tiempo de viaje:</strong> Considera 30-45 minutos desde el centro según el tráfico.</li>
        <li><strong>Vacaciones:</strong> Durante vacaciones de verano las frecuencias pueden reducirse significativamente.</li>
      </ul>
    </section>
    
    <section class="section">
      <h2>🗺️ Ubicación de Ciudad Universitaria</h2>
      <div class="info-box">
        <p>Ciudad Universitaria está ubicada al noreste de la ciudad de Córdoba, sobre Av. Vélez Sarsfield y Av. Valparaíso.</p>
        <p><strong>Dirección:</strong> Av. Vélez Sarsfield 1611, Córdoba</p>
        <p><strong>Facultades:</strong> FCEFyN, FCQ, FCS, Rectorado, y otras dependencias de la UNC</p>
      </div>
    </section>
    
    <section class="section">
      <h2>Paradas principales en Ciudad Universitaria</h2>
      <ul class="stops-list">
        <li>Entrada principal - Av. Vélez Sarsfield</li>
        <li>FCEFyN - Facultad de Ciencias Exactas</li>
        <li>Comedor Universitario</li>
        <li>FCQ - Facultad de Ciencias Químicas</li>
        <li>FCS - Facultad de Ciencias de la Salud</li>
      </ul>
    </section>
    <section class="section">
      <h2>Ver más destinos</h2>
      <div class="related-links">
        <a href="/como-llegar/aeropuerto" class="btn">Aeropuerto</a>
        <a href="/como-llegar/terminal" class="btn">Terminal de Ómnibus</a>
        <a href="/lineas" class="btn">Todas las líneas</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subtitle {
    color: var(--color-text-light);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  
  .section {
    margin: 3rem 0;
  }
  
  .line-option {
    display: flex;
    gap: 1.5rem;
    align-items: start;
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .line-badge {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 1.5rem;
  }
  
  .line-option h3 {
    margin-bottom: 0.5rem;
  }
  
  .line-option p {
    margin-bottom: 0.5rem;
    color: var(--color-text-light);
  }
  
  .tips-list, .stops-list {
    list-style-position: outside;
    margin-left: 1.5rem;
  }
  
  .tips-list li, .stops-list li {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  
  .info-box {
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-top: 1rem;
  }
  
  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  
  @media (max-width: 640px) {
    .line-option {
      flex-direction: column;
    }
  }
</style>
