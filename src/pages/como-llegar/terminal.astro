---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSense from '../../components/AdSense.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Cómo llegar', href: '/como-llegar' },
  { label: 'Terminal de Ómnibus' }
];
---

<BaseLayout 
  title="Cómo llegar a la Terminal de Ómnibus de Córdoba - BondiCórdoba"
  description="Todas las líneas de colectivos que pasan por la Terminal de Ómnibus de Córdoba. Consulta recorridos y horarios."
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    
    <h1>🚏 Cómo llegar a la Terminal de Ómnibus</h1>
    <p class="subtitle">Terminal de Ómnibus de Córdoba - Bv. Perón 380</p>
    
    <div class="alert alert-warning">
      <strong>⚠️ Datos de ejemplo:</strong> Esta información es ficticia. Consulte fuentes oficiales para planificar su viaje.
    </div>
    
    <section class="section">
      <h2>Líneas que pasan por la terminal</h2>
      <p>La Terminal de Ómnibus es uno de los puntos más conectados de la ciudad. Múltiples líneas tienen paradas en o cerca de la terminal.</p>
      
      <div class="lines-list">
        <div class="line-item">
          <span class="line-number">1</span>
          <div>
            <p><strong>Línea Ejemplo 1</strong></p>
            <p>Centro - Barrio Norte</p>
          </div>
          <a href="/lineas/1" class="btn">Ver detalles</a>
        </div>
        
        <div class="line-item">
          <span class="line-number">10</span>
          <div>
            <p><strong>Línea Ejemplo 10</strong></p>
            <p>Villa El Libertador - Centro - Arguello</p>
          </div>
          <a href="/lineas/10" class="btn">Ver detalles</a>
        </div>
      </div>
    </section>
    
    <AdSense />
    
    <section class="section">
      <h2>💡 Información útil</h2>
      <ul class="info-list">
        <li><strong>Ubicación:</strong> Bv. Perón 380, Centro, Córdoba</li>
        <li><strong>Paradas:</strong> Las paradas están ubicadas sobre Bv. Perón, frente y alrededores de la terminal</li>
        <li><strong>Horario de atención:</strong> La terminal funciona las 24 horas</li>
        <li><strong>Servicios:</strong> La terminal cuenta con baños, locales comerciales, kioscos y servicios de información</li>
      </ul>
    </section>
    
    <section class="section">
      <h2>🗺️ Ubicación</h2>
      <div class="info-box">
        <p>La Terminal de Ómnibus está ubicada en pleno centro de Córdoba, sobre Bv. Perón entre Bv. Illia y Av. Costanera.</p>
        <p><strong>Dirección:</strong> Bv. Perón 380, Córdoba Capital</p>
      </div>
    </section>
    
    <AdSense />
    
    <section class="section">
      <h2>Ver más destinos</h2>
      <div class="related-links">
        <a href="/como-llegar/aeropuerto" class="btn">Aeropuerto</a>
        <a href="/como-llegar/ciudad-universitaria" class="btn">Ciudad Universitaria</a>
        <a href="/lineas" class="btn">Todas las líneas</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subtitle {
    color: var(--color-text-light);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  
  .section {
    margin: 3rem 0;
  }
  
  .lines-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  
  .line-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
  }
  
  .line-number {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
  }
  
  .line-item > div {
    flex: 1;
  }
  
  .line-item p:last-child {
    color: var(--color-text-light);
    font-size: 0.875rem;
  }
  
  .info-list {
    list-style-position: outside;
    margin-left: 1.5rem;
  }
  
  .info-list li {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  
  .info-box {
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-top: 1rem;
  }
  
  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  
  @media (max-width: 640px) {
    .line-item {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
