---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSense from '../../components/AdSense.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Cómo llegar', href: '/como-llegar' },
  { label: 'Aeropuerto' }
];
---

<BaseLayout 
  title="Cómo llegar al Aeropuerto de Córdoba en colectivo - BondiCórdoba"
  description="Guía completa para llegar al Aeropuerto Internacional Ingeniero Ambrosio Taravella en colectivo desde diferentes puntos de Córdoba Capital."
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    
    <h1>✈️ Cómo llegar al Aeropuerto</h1>
    <p class="subtitle">Aeropuerto Internacional Ingeniero Ambrosio Taravella (Pajas Blancas)</p>
    
    <div class="alert alert-warning">
      <strong>⚠️ Datos de ejemplo:</strong> Esta información es ficticia. Consulte fuentes oficiales para planificar su viaje.
    </div>
    
    <section class="section">
      <h2>Líneas que llegan al aeropuerto</h2>
      
      <div class="line-option">
        <div class="line-badge">Ejemplo 1</div>
        <div>
          <h3>Línea Ejemplo 1 - Aeropuerto</h3>
          <p><strong>Desde:</strong> Centro - Terminal de Ómnibus</p>
          <p><strong>Frecuencia:</strong> Cada 30 minutos (aproximadamente)</p>
          <p><strong>Tiempo estimado:</strong> 45-60 minutos</p>
          <p><strong>Recorrido principal:</strong> Terminal → Av. Colón → Circunvalación → Aeropuerto</p>
          <a href="/lineas" class="btn">Ver recorrido completo</a>
        </div>
      </div>
    </section>
    
    <AdSense />
    
    <section class="section">
      <h2>💡 Consejos para viajar al aeropuerto</h2>
      <ul class="tips-list">
        <li><strong>Tiempo de viaje:</strong> Considere entre 45 minutos a 1 hora de viaje desde el centro. Agregue tiempo extra por tráfico.</li>
        <li><strong>Horarios:</strong> Verifique que haya servicios disponibles en el horario de su vuelo, especialmente temprano por la mañana o tarde por la noche.</li>
        <li><strong>Equipaje:</strong> Asegúrese de poder subir su equipaje al colectivo cómodamente.</li>
        <li><strong>Tarjeta Red Bus:</strong> Tenga su tarjeta cargada con anticipación.</li>
        <li><strong>Alternativas:</strong> Si tiene mucho equipaje o viaja muy temprano/tarde, considere un taxi o remis.</li>
      </ul>
    </section>
    
    <section class="section">
      <h2>🗺️ Ubicación del Aeropuerto</h2>
      <p>El Aeropuerto Internacional de Córdoba está ubicado en Pajas Blancas, a unos 11 km del centro de la ciudad por Av. Armada Argentina.</p>
      <div class="info-box">
        <p><strong>Dirección:</strong> Av. Armada Argentina S/N, Pajas Blancas, Córdoba</p>
        <p><strong>Teléfono:</strong> Consultar información oficial del aeropuerto</p>
      </div>
    </section>
    
    <section class="section">
      <h2>Otras opciones de transporte</h2>
      <div class="transport-options">
        <div class="transport-card">
          <h3>🚖 Taxi/Remis</h3>
          <p>Servicio directo desde cualquier punto de la ciudad. Tiempo estimado: 20-30 minutos desde el centro.</p>
        </div>
        <div class="transport-card">
          <h3>🚗 Auto particular</h3>
          <p>El aeropuerto cuenta con estacionamiento. Acceso por Av. Armada Argentina.</p>
        </div>
      </div>
    </section>
    
    <AdSense />
    
    <section class="section">
      <h2>Ver más destinos</h2>
      <div class="related-links">
        <a href="/como-llegar/terminal" class="btn">Terminal de Ómnibus</a>
        <a href="/como-llegar/ciudad-universitaria" class="btn">Ciudad Universitaria</a>
        <a href="/lineas" class="btn">Todas las líneas</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subtitle {
    color: var(--color-text-light);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  
  .section {
    margin: 3rem 0;
  }
  
  .line-option {
    display: flex;
    gap: 1.5rem;
    align-items: start;
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .line-badge {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: 0.5rem;
    font-weight: 700;
    text-align: center;
    font-size: 0.875rem;
  }
  
  .line-option h3 {
    margin-bottom: 0.5rem;
  }
  
  .line-option p {
    margin-bottom: 0.5rem;
    color: var(--color-text-light);
  }
  
  .tips-list {
    list-style-position: outside;
    margin-left: 1.5rem;
  }
  
  .tips-list li {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  
  .info-box {
    background: var(--color-bg-light);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-top: 1rem;
  }
  
  .transport-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  
  .transport-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  
  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  
  @media (max-width: 640px) {
    .line-option {
      flex-direction: column;
    }
  }
</style>
