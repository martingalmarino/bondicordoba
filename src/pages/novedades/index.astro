---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Novedades' }
];

const novedades = [
  {
    slug: 'ejemplo-cambio-recorrido',
    titulo: 'Cambio de recorrido temporal - Línea Ejemplo (EJEMPLO)',
    fecha: '2026-10-15',
    resumen: 'Información sobre cambio temporal en el recorrido. Datos de ejemplo.',
    categoria: 'Cambios de recorrido'
  }
];
---

<BaseLayout 
  title="Novedades sobre colectivos en Córdoba - BondiCórdoba"
  description="Últimas novedades, cambios de recorridos, paros y avisos importantes sobre el transporte público en Córdoba Capital."
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    
    <h1>📰 Novedades</h1>
    <p class="subtitle">Últimas noticias y avisos sobre el transporte público en Córdoba</p>
    
    <div class="alert alert-info">
      <strong>ℹ️ Atención:</strong> Esta sección contiene actualmente contenido de ejemplo. 
      Para información oficial sobre paros, cambios de recorrido y novedades, consulte 
      <a href="https://www.cordoba.gob.ar" target="_blank" rel="noopener">Municipalidad de Córdoba</a> o 
      <a href="https://tamse.gob.ar" target="_blank" rel="noopener">TAMSE</a>.
    </div>
    
    <section class="section">
      {novedades.length > 0 ? (
        <div class="news-grid">
          {novedades.map(noticia => (
            <article class="news-card">
              <span class="category">{noticia.categoria}</span>
              <h2>
                <a href={`/novedades/${noticia.slug}`}>{noticia.titulo}</a>
              </h2>
              <time datetime={noticia.fecha}>
                {new Date(noticia.fecha).toLocaleDateString('es-AR', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              <p>{noticia.resumen}</p>
              <a href={`/novedades/${noticia.slug}`} class="read-more">
                Leer más →
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No hay novedades disponibles en este momento.</p>
          <p>Estamos trabajando en mantener esta sección actualizada con información relevante.</p>
        </div>
      )}
    </section>
    
    <section class="section">
      <h2>Fuentes oficiales de información</h2>
      <div class="sources">
        <div class="source-card">
          <h3>🏛️ Municipalidad de Córdoba</h3>
          <p>Información oficial sobre transporte público</p>
          <a href="https://www.cordoba.gob.ar" target="_blank" rel="noopener" class="btn">
            Visitar sitio
          </a>
        </div>
        <div class="source-card">
          <h3>🚌 TAMSE</h3>
          <p>Transporte Automotor Municipal Sociedad del Estado</p>
          <a href="https://tamse.gob.ar" target="_blank" rel="noopener" class="btn">
            Visitar sitio
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subtitle {
    color: var(--color-text-light);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  
  .section {
    margin: 3rem 0;
  }
  
  .news-grid {
    display: grid;
    gap: 1.5rem;
  }
  
  .news-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  
  .category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary);
    color: white;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  
  .news-card h2 {
    margin-bottom: 0.5rem;
  }
  
  .news-card h2 a {
    color: var(--color-text);
  }
  
  .news-card h2 a:hover {
    color: var(--color-primary);
  }
  
  .news-card time {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }
  
  .news-card p {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }
  
  .read-more {
    color: var(--color-primary);
    font-weight: 500;
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem;
    background: var(--color-bg-light);
    border-radius: 0.5rem;
  }
  
  .empty-state p {
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }
  
  .sources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .source-card {
    background: var(--color-bg-light);
    padding: 2rem;
    border-radius: 0.5rem;
    text-align: center;
  }
  
  .source-card h3 {
    margin-bottom: 1rem;
  }
  
  .source-card p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }
</style>
