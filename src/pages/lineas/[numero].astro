---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Alert from '../../components/Alert.astro';
import Table from '../../components/Table.astro';
import { Icon } from 'astro-icon/components';
import { getLineas, getLineaByNumero, hasValidSchedule } from '../../data/lineas';

export async function getStaticPaths() {
  const lineas = await getLineas();
  return lineas.map((linea) => ({
    params: { numero: linea.numero },
    props: { linea },
  }));
}

const { numero } = Astro.params;
const linea = await getLineaByNumero(numero);

if (!linea) {
  return Astro.redirect('/404');
}

const breadcrumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Líneas', href: '/lineas' },
  { label: `Línea ${linea.numero}` }
];

const hasIda = linea.recorrido?.ida?.calles && linea.recorrido.ida.calles.length > 0;
const hasVuelta = linea.recorrido?.vuelta?.calles && linea.recorrido.vuelta.calles.length > 0;
const hasRouteData = hasIda || hasVuelta;
const hasSchedule = hasValidSchedule(linea);
---

<BaseLayout 
  title={`Línea ${linea.numero}${linea.nombre ? ` - ${linea.nombre}` : ''}`}
  description={`Información completa sobre la línea ${linea.numero} de Córdoba Capital. ${linea.recorrido?.ida?.descripcion || linea.recorrido?.vuelta?.descripcion || ''}`}
>
  <div class="container page-container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="line-header">
      <div class="line-header-top">
        <div class="line-number-badge">
          <Icon name="lucide:bus" class="line-icon" />
          <span class="line-number-text">{linea.numero}</span>
        </div>
        <div class="line-header-info">
          <h1 class="line-name">{linea.nombre || `Línea ${linea.numero}`}</h1>
          {linea.empresa && (
            <p class="line-company">
              <Icon name="lucide:building-2" class="company-icon" />
              {linea.empresa}
            </p>
          )}
        </div>
      </div>

      {(linea.recorrido?.ida?.descripcion || linea.recorrido?.vuelta?.descripcion) && (
        <div class="line-route-summary">
          <Icon name="lucide:route" class="route-icon" />
          <div>
            {linea.recorrido.ida?.descripcion && <p>{linea.recorrido.ida.descripcion}</p>}
            {linea.recorrido.vuelta?.descripcion && !linea.recorrido.ida?.descripcion && (
              <p>{linea.recorrido.vuelta.descripcion}</p>
            )}
          </div>
        </div>
      )}
    </header>

    <div class="line-content">
      <div class="line-main">
        {hasRouteData ? (
          <section class="section">
            <h2 class="section-title">
              <Icon name="lucide:map" />
              Recorridos
            </h2>

            {hasIda && linea.recorrido?.ida && (
              <div class="route-section">
                <h3 class="route-title">
                  <Badge variant="info">Ida</Badge>
                  {linea.recorrido.ida.descripcion && (
                    <span class="route-subtitle">{linea.recorrido.ida.descripcion}</span>
                  )}
                </h3>
                <ul class="route-streets">
                  {linea.recorrido.ida.calles.map((calle: string) => (
                    <li>
                      <Icon name="lucide:corner-down-right" class="street-icon" />
                      {calle}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {hasVuelta && linea.recorrido?.vuelta && (
              <div class="route-section">
                <h3 class="route-title">
                  <Badge variant="success">Vuelta</Badge>
                  {linea.recorrido.vuelta.descripcion && (
                    <span class="route-subtitle">{linea.recorrido.vuelta.descripcion}</span>
                  )}
                </h3>
                <ul class="route-streets">
                  {linea.recorrido.vuelta.calles.map((calle: string) => (
                    <li>
                      <Icon name="lucide:corner-down-right" class="street-icon" />
                      {calle}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ) : (
          <Alert variant="warning" title="Recorridos pendientes">
            La información detallada de recorridos para esta línea estará disponible próximamente.
          </Alert>
        )}

        {linea.paradasPrincipales && linea.paradasPrincipales.length > 0 && (
          <section class="section">
            <h2 class="section-title">
              <Icon name="lucide:map-pin" />
              Paradas principales
            </h2>
            <ul class="stops-list">
              {linea.paradasPrincipales.map((parada: string) => (
                <li>
                  <Icon name="lucide:circle-dot" class="stop-icon" />
                  {parada}
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="section">
          <h2 class="section-title">
            <Icon name="lucide:clock" />
            Horarios
          </h2>
          {hasSchedule && linea.horarios ? (
            <Table striped>
              <thead>
                <tr>
                  <th>Período</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                {linea.horarios.lunesAViernes && (
                  <tr>
                    <td>Lunes a Viernes</td>
                    <td>
                      {linea.horarios.lunesAViernes.descripcion}
                      {linea.horarios.lunesAViernes.horarioInicio && linea.horarios.lunesAViernes.horarioFin && (
                        <span class="schedule-time">
                          {` (${linea.horarios.lunesAViernes.horarioInicio} - ${linea.horarios.lunesAViernes.horarioFin})`}
                        </span>
                      )}
                    </td>
                  </tr>
                )}
                {linea.horarios.sabados && (
                  <tr>
                    <td>Sábados</td>
                    <td>
                      {linea.horarios.sabados.descripcion}
                      {linea.horarios.sabados.horarioInicio && linea.horarios.sabados.horarioFin && (
                        <span class="schedule-time">
                          {` (${linea.horarios.sabados.horarioInicio} - ${linea.horarios.sabados.horarioFin})`}
                        </span>
                      )}
                    </td>
                  </tr>
                )}
                {linea.horarios.domingosYFeriados && (
                  <tr>
                    <td>Domingos y Feriados</td>
                    <td>
                      {linea.horarios.domingosYFeriados.descripcion}
                      {linea.horarios.domingosYFeriados.horarioInicio && linea.horarios.domingosYFeriados.horarioFin && (
                        <span class="schedule-time">
                          {` (${linea.horarios.domingosYFeriados.horarioInicio} - ${linea.horarios.domingosYFeriados.horarioFin})`}
                        </span>
                      )}
                    </td>
                  </tr>
                )}
              </tbody>
            </Table>
          ) : (
            <Alert variant="warning" title="Horarios pendientes">
              Los horarios detallados para esta línea estarán disponibles próximamente.
            </Alert>
          )}
        </section>

        {linea.tarifas && (linea.tarifas.efectivo || linea.tarifas.redBus) && (
          <section class="section">
            <h2 class="section-title">
              <Icon name="lucide:credit-card" />
              Tarifas
            </h2>
            <div class="tarifas-content">
              {linea.tarifas.efectivo && (
                <div class="tarifa-item">
                  <strong>Efectivo:</strong> {linea.tarifas.efectivo}
                </div>
              )}
              {linea.tarifas.redBus && (
                <div class="tarifa-item">
                  <strong>Red Bus:</strong> {linea.tarifas.redBus}
                </div>
              )}
            </div>
          </section>
        )}

        {linea.notas && (
          <Alert variant="info">
            <p>{linea.notas}</p>
          </Alert>
        )}

        <div class="line-meta">
          {linea.ultimaActualizacion && (
            <p class="meta-item">
              <Icon name="lucide:calendar" class="meta-icon" />
              <strong>Última actualización:</strong> {new Date(linea.ultimaActualizacion).toLocaleDateString('es-AR')}
            </p>
          )}
          {linea.fuente && (
            <p class="meta-item">
              <Icon name="lucide:link" class="meta-icon" />
              <strong>Fuente:</strong> <a href={linea.fuente} target="_blank" rel="noopener noreferrer">Datos oficiales</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .line-header {
    margin-bottom: var(--space-8);
    padding: var(--space-8);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    border-radius: var(--radius-lg);
  }

  .line-header-top {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .line-number-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-white);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-h2);
    flex-shrink: 0;
    box-shadow: var(--shadow-md);
  }

  .line-icon {
    width: 32px;
    height: 32px;
  }

  .line-number-text {
    line-height: 1;
  }

  .line-header-info {
    flex: 1;
  }

  .line-name {
    font-size: var(--font-size-h1);
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .line-company {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-base);
    color: var(--color-white);
    opacity: 0.9;
    margin: 0;
  }

  .company-icon {
    width: 18px;
    height: 18px;
  }

  .line-route-summary {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
  }

  .route-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .line-route-summary p {
    margin: 0;
    line-height: var(--line-height-normal);
  }

  .line-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .section {
    margin-bottom: var(--space-8);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-h3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-gray-200);
  }

  .section-title :global(svg) {
    width: 28px;
    height: 28px;
    color: var(--color-primary);
  }

  .route-section {
    margin-bottom: var(--space-8);
  }

  .route-section:last-child {
    margin-bottom: 0;
  }

  .route-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-4);
  }

  .route-subtitle {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    color: var(--color-gray-600);
  }

  .route-streets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .route-streets li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2);
    background-color: var(--color-gray-50);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-small);
    color: var(--color-gray-700);
  }

  .street-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gray-500);
  }

  .stops-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .stops-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    background-color: var(--color-gray-50);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    color: var(--color-gray-700);
  }

  .stop-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-primary);
  }

  .tarifas-content {
    display: grid;
    gap: var(--space-4);
  }

  .tarifa-item {
    padding: var(--space-4);
    background-color: var(--color-gray-50);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    color: var(--color-gray-700);
  }

  .line-meta {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-gray-50);
    border-radius: var(--radius-md);
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    color: var(--color-gray-700);
    margin-bottom: var(--space-3);
  }

  .meta-item:last-child {
    margin-bottom: 0;
  }

  .meta-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gray-500);
  }

</style>
