---
interface Props {
  class?: string;
  striped?: boolean;
  bordered?: boolean;
}

const { class: className = '', striped = false, bordered = true } = Astro.props;
---

<div class="table-wrapper">
  <table class:list={[
    'table', 
    className,
    { 'table-striped': striped, 'table-bordered': bordered }
  ]}>
    <slot />
  </table>
</div>

<style>
  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: var(--space-4) 0;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-small);
  }

  .table :global(th),
  .table :global(td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
  }

  .table :global(th) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-gray-800);
    background-color: var(--color-gray-100);
    white-space: nowrap;
  }

  .table :global(td) {
    color: var(--color-gray-700);
  }

  .table-bordered :global(th),
  .table-bordered :global(td) {
    border: 1px solid var(--color-gray-300);
  }

  .table-striped :global(tbody tr:nth-child(even)) {
    background-color: var(--color-gray-50);
  }

  .table :global(tbody tr):hover {
    background-color: var(--color-primary-light);
  }

  @media (max-width: 767px) {
    .table {
      font-size: var(--font-size-xsmall);
    }

    .table :global(th),
    .table :global(td) {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
