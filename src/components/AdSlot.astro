---
interface Props {
  slot: string;
  format?: 'horizontal' | 'vertical' | 'square';
  class?: string;
}

const { slot, format = 'horizontal', class: className = '' } = Astro.props;

const heights = {
  horizontal: '90px',
  vertical: '600px',
  square: '250px'
};
---

<aside 
  class:list={['ad-slot', `ad-slot-${format}`, className]} 
  aria-label="Publicidad"
>
  <span class="ad-label">Publicidad</span>
  <div 
    class="ad-container" 
    data-ad-slot={slot}
    style={`min-height: ${heights[format]}`}
  >
    <div class="ad-placeholder">
      <p>Espacio publicitario</p>
    </div>
  </div>
</aside>

<style>
  .ad-slot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-8) 0;
  }

  .ad-label {
    font-size: var(--font-size-xsmall);
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-weight-medium);
  }

  .ad-container {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .ad-placeholder p {
    font-size: var(--font-size-small);
    color: var(--color-gray-400);
    margin: 0;
  }

  .ad-slot-horizontal .ad-container {
    width: 100%;
  }

  .ad-slot-vertical .ad-container {
    width: 100%;
    max-width: 300px;
  }

  .ad-slot-square .ad-container {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
  }
</style>
