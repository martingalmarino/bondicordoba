---
import type { LineaColectivo } from '../types';

interface Props {
  linea: LineaColectivo;
}

const { linea } = Astro.props;
---

<article class="line-card">
  {linea.esEjemplo && (
    <div class="example-badge">EJEMPLO</div>
  )}
  <div class="line-number">
    <span>{linea.numero}</span>
  </div>
  <div class="line-info">
    <h3 class="line-name">
      <a href={`/lineas/${linea.numero}`}>{linea.nombre}</a>
    </h3>
    <p class="line-description">{linea.descripcionCorta}</p>
    <div class="line-meta">
      <span class="company">{linea.empresa}</span>
    </div>
    {linea.recorrido.ida.calles.length > 0 && (
      <div class="line-route">
        <div class="route-section">
          <strong>Ida:</strong> {linea.recorrido.ida.calles[0]} → {linea.recorrido.ida.calles[linea.recorrido.ida.calles.length - 1]}
        </div>
      </div>
    )}
  </div>
</article>

<style>
  .line-card {
    position: relative;
    display: flex;
    gap: 1rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }
  
  .line-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .example-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: #f59e0b;
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
  }
  
  .line-number {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .line-info {
    flex: 1;
    min-width: 0;
  }
  
  .line-name {
    margin-bottom: 0.25rem;
  }
  
  .line-name a {
    color: var(--color-text);
  }
  
  .line-name a:hover {
    color: var(--color-primary);
  }
  
  .line-description {
    color: var(--color-text-light);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }
  
  .line-meta {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }
  
  .line-route {
    font-size: 0.875rem;
    color: var(--color-text);
  }
  
  .route-section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  
  @media (max-width: 640px) {
    .line-card {
      flex-direction: column;
    }
    
    .line-number {
      width: 3rem;
      height: 3rem;
      font-size: 1.25rem;
    }
  }
</style>
