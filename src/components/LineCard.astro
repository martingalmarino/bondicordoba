---
import { Icon } from 'astro-icon/components';

interface Props {
  numero: string;
  nombre?: string;
  recorrido?: string;
  empresa?: string;
  href: string;
}

const { numero, nombre, recorrido, empresa, href } = Astro.props;
---

<a href={href} class="line-card">
  <div class="line-card-header">
    <div class="line-number">
      <Icon name="lucide:bus" class="line-icon" />
      <span class="line-number-text">{numero}</span>
    </div>
    {nombre && <h3 class="line-name">{nombre}</h3>}
  </div>

  <div class="line-card-body">
    {recorrido && (
      <p class="line-route">
        <Icon name="lucide:route" class="route-icon" />
        <span>{recorrido}</span>
      </p>
    )}
    {empresa && (
      <p class="line-company">
        <Icon name="lucide:building-2" class="company-icon" />
        <span>{empresa}</span>
      </p>
    )}
  </div>

  <div class="line-card-footer">
    <span class="line-card-link">
      Ver detalles
      <Icon name="lucide:chevron-right" class="chevron-icon" />
    </span>
  </div>
</a>

<style>
  .line-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
    text-decoration: none;
    color: inherit;
  }

  .line-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .line-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .line-number {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-h4);
    flex-shrink: 0;
  }

  .line-icon {
    width: 20px;
    height: 20px;
  }

  .line-number-text {
    line-height: 1;
  }

  .line-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-gray-800);
    margin: 0;
  }

  .line-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .line-route,
  .line-company {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    color: var(--color-gray-600);
    margin: 0;
  }

  .route-icon,
  .company-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .line-card-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-gray-200);
  }

  .line-card-link {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .chevron-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-fast);
  }

  .line-card:hover .chevron-icon {
    transform: translateX(4px);
  }
</style>
